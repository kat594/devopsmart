* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f7fa;
    color: #222;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
}

header {
    background: #111827;
    color: white;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
}

.logo {
    color: white;
    text-decoration: none;
    font-size: 24px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

main {
    min-height: 80vh;
    padding: 40px 0;
}

.hero {
    text-align: center;
    padding: 60px 20px;
}

.hero h1 {
    font-size: 48px;
}

.hero p {
    font-size: 20px;
}

.button {
    display: inline-block;
    background: #2563eb;
    color: white;
    padding: 10px 18px;
    border: none;
    border-radius: 6px;
    text-decoration: none;
    cursor: pointer;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.product-card {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.product-icon {
    font-size: 40px;
}

.product-icon.large {
    font-size: 80px;
}

.category {
    color: #2563eb;
    font-weight: bold;
}

.product-detail {
    background: white;
    padding: 40px;
    border-radius: 10px;
    display: flex;
    gap: 40px;
    align-items: center;
}

footer {
    text-align: center;
    padding: 25px;
    background: #111827;
    color: white;
}


/* ================================
   Modern DevOpsMart Homepage
   ================================ */

.hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
    padding: 70px 40px;
    margin-bottom: 70px;
    overflow: hidden;
    border-radius: 28px;
    background:
        radial-gradient(circle at 80% 20%, rgba(80, 120, 255, 0.20), transparent 30%),
        radial-gradient(circle at 20% 80%, rgba(0, 200, 180, 0.15), transparent 30%);
}

.hero-content {
    max-width: 650px;
    position: relative;
    z-index: 2;
}

.hero-badge {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 20px;
    border: 1px solid rgba(100, 120, 255, 0.35);
}

.hero h1 {
    font-size: clamp(48px, 7vw, 82px);
    line-height: 0.95;
    margin: 0 0 25px;
    letter-spacing: -4px;
}

.hero h1 span {
    display: block;
}

.hero p {
    font-size: 19px;
    line-height: 1.7;
    max-width: 600px;
    opacity: 0.8;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 30px;
    flex-wrap: wrap;
}

.secondary-button {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.floating-orbit {
    width: 400px;
    height: 400px;
    position: relative;
    flex-shrink: 0;
}

.orbit-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 42px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 0 60px rgba(80, 120, 255, 0.25);
}

.floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-radius: 16px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    animation: float 5s ease-in-out infinite;
}

.card-one {
    top: 35px;
    left: 20px;
}

.card-two {
    top: 40px;
    right: 10px;
    animation-delay: 1s;
}

.card-three {
    bottom: 45px;
    left: 30px;
    animation-delay: 2s;
}

.card-four {
    bottom: 35px;
    right: 5px;
    animation-delay: 3s;
}

@keyframes float {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-15px);
    }

}

.featured-section {
    margin-bottom: 70px;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
}

.section-label {
    font-size: 12px !important;
    font-weight: 700;
    letter-spacing: 1.5px;
    opacity: 0.55 !important;
    margin: 0 0 8px !important;
}

.section-heading h2 {
    margin: 0;
    font-size: 32px;
}

.view-all {
    text-decoration: none;
    font-weight: 600;
}

.platform-section {
    margin-bottom: 50px;
}

.platform-card {
    display: flex;
    align-items: center;
    gap: 25px;
    padding: 35px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.platform-icon {
    font-size: 45px;
}

.platform-card h2 {
    margin: 0 0 8px;
}

.platform-card p {
    margin: 0;
    opacity: 0.7;
}

.platform-card .button {
    margin-left: auto;
    white-space: nowrap;
}

@media (max-width: 900px) {

    .hero {
        flex-direction: column;
        text-align: center;
    }

    .hero-content {
        max-width: 100%;
    }

    .hero-buttons {
        justify-content: center;
    }

    .floating-orbit {
        width: 320px;
        height: 320px;
    }

    .platform-card {
        flex-direction: column;
        text-align: center;
    }

    .platform-card .button {
        margin-left: 0;
    }

}


/* =========================================================
   DEVOPSMART - COLORFUL MODERN HOMEPAGE
   ========================================================= */

body {
    background:
        radial-gradient(circle at 10% 10%, rgba(79, 70, 229, 0.12), transparent 30%),
        radial-gradient(circle at 90% 20%, rgba(6, 182, 212, 0.10), transparent 30%),
        radial-gradient(circle at 50% 90%, rgba(168, 85, 247, 0.08), transparent 35%);
}


/* =========================
   HERO
   ========================= */

.hero {
    position: relative;
    min-height: 540px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    padding: 70px 55px;
    margin-bottom: 80px;
    overflow: hidden;
    border-radius: 32px;

    background:
        linear-gradient(
            135deg,
            rgba(30, 41, 120, 0.95),
            rgba(76, 29, 149, 0.90),
            rgba(14, 116, 144, 0.90)
        );

    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.30);
}


/* glowing background circles */

.hero::before {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.25);
    filter: blur(30px);
    top: -180px;
    right: -100px;
}

.hero::after {
    content: "";
    position: absolute;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    background: rgba(236, 72, 153, 0.20);
    filter: blur(35px);
    bottom: -180px;
    left: -100px;
}


.hero-content {
    max-width: 650px;
    position: relative;
    z-index: 3;
}


.hero-badge {
    display: inline-block;
    padding: 9px 16px;
    border-radius: 30px;

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;

    color: white;

    background: rgba(255, 255, 255, 0.14);

    border: 1px solid rgba(255, 255, 255, 0.25);

    backdrop-filter: blur(10px);

    box-shadow:
        0 8px 25px rgba(0, 0, 0, 0.15);
}


.hero h1 {
    font-size: clamp(52px, 7vw, 86px);
    line-height: 0.95;
    margin: 25px 0;
    letter-spacing: -4px;
    color: white;
}


.hero h1 span {
    display: block;

    background:
        linear-gradient(
            90deg,
            #67e8f9,
            #a78bfa,
            #f0abfc
        );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}


.hero p {
    font-size: 19px;
    line-height: 1.7;
    max-width: 600px;
    color: rgba(255, 255, 255, 0.82);
}


/* =========================
   BUTTONS
   ========================= */

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 32px;
    flex-wrap: wrap;
}


.hero .button {
    border: none;

    background:
        linear-gradient(
            135deg,
            #06b6d4,
            #6366f1,
            #a855f7
        );

    color: white;

    box-shadow:
        0 12px 30px rgba(99, 102, 241, 0.35);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}


.hero .button:hover {
    transform: translateY(-3px);

    box-shadow:
        0 18px 40px rgba(99, 102, 241, 0.50);
}


.secondary-button {
    background: rgba(255, 255, 255, 0.10) !important;

    border: 1px solid rgba(255, 255, 255, 0.25) !important;

    box-shadow: none !important;
}


/* =========================
   FLOATING TECHNOLOGY AREA
   ========================= */

.floating-orbit {
    width: 420px;
    height: 420px;
    position: relative;
    flex-shrink: 0;

    z-index: 3;
}


.floating-orbit::before {
    content: "";

    position: absolute;

    width: 310px;
    height: 310px;

    left: 55px;
    top: 55px;

    border-radius: 50%;

    border:
        1px dashed rgba(255, 255, 255, 0.25);

    animation: rotateOrbit 20s linear infinite;
}


@keyframes rotateOrbit {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

}


.orbit-center {
    position: absolute;

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    width: 115px;
    height: 115px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    font-size: 48px;

    background:
        linear-gradient(
            135deg,
            rgba(59, 130, 246, 0.9),
            rgba(168, 85, 247, 0.9)
        );

    border:
        3px solid rgba(255, 255, 255, 0.25);

    box-shadow:
        0 0 40px rgba(99, 102, 241, 0.6),
        0 0 100px rgba(168, 85, 247, 0.25);

    animation: centerPulse 3s ease-in-out infinite;
}


@keyframes centerPulse {

    0%, 100% {
        transform: translate(-50%, -50%) scale(1);
    }

    50% {
        transform: translate(-50%, -50%) scale(1.06);
    }

}


/* floating cards */

.floating-card {
    position: absolute;

    display: flex;
    align-items: center;
    gap: 10px;

    padding: 15px 20px;

    border-radius: 18px;

    font-weight: 700;

    color: white;

    backdrop-filter: blur(15px);

    border:
        1px solid rgba(255, 255, 255, 0.22);

    box-shadow:
        0 20px 45px rgba(0, 0, 0, 0.25);

    animation: floatCard 5s ease-in-out infinite;

    z-index: 4;
}


.card-one {
    top: 25px;
    left: 10px;

    background:
        linear-gradient(
            135deg,
            rgba(37, 99, 235, 0.85),
            rgba(6, 182, 212, 0.75)
        );
}


.card-two {
    top: 30px;
    right: 0;

    background:
        linear-gradient(
            135deg,
            rgba(124, 58, 237, 0.85),
            rgba(168, 85, 247, 0.75)
        );

    animation-delay: 1s;
}


.card-three {
    bottom: 30px;
    left: 20px;

    background:
        linear-gradient(
            135deg,
            rgba(5, 150, 105, 0.85),
            rgba(14, 165, 233, 0.75)
        );

    animation-delay: 2s;
}


.card-four {
    bottom: 25px;
    right: -5px;

    background:
        linear-gradient(
            135deg,
            rgba(234, 88, 12, 0.85),
            rgba(236, 72, 153, 0.75)
        );

    animation-delay: 3s;
}


@keyframes floatCard {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-14px);
    }

}


/* =========================
   FEATURED PRODUCTS
   ========================= */

.featured-section {
    margin-bottom: 80px;
}


.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 35px;
}


.section-label {
    font-size: 12px !important;
    font-weight: 800;
    letter-spacing: 1.8px;

    background:
        linear-gradient(
            90deg,
            #06b6d4,
            #8b5cf6
        );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    margin: 0 0 8px !important;
}


.section-heading h2 {
    margin: 0;
    font-size: 36px;
}


.view-all {
    text-decoration: none;
    font-weight: 700;

    padding: 10px 16px;

    border-radius: 12px;

    background:
        rgba(99, 102, 241, 0.10);

    transition: transform 0.2s ease;
}


.view-all:hover {
    transform: translateX(4px);
}


/* Homepage product cards */

.featured-section .product-card {

    border-radius: 22px;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.08),
            rgba(255, 255, 255, 0.03)
        );

    border:
        1px solid rgba(255, 255, 255, 0.10);

    box-shadow:
        0 15px 40px rgba(0, 0, 0, 0.12);

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}


.featured-section .product-card:hover {

    transform: translateY(-8px);

    box-shadow:
        0 25px 55px rgba(99, 102, 241, 0.20);
}


.featured-section .product-icon {

    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 16px;

    font-size: 28px;

    background:
        linear-gradient(
            135deg,
            rgba(59, 130, 246, 0.20),
            rgba(168, 85, 247, 0.20)
        );
}


/* =========================
   PLATFORM BANNER
   ========================= */

.platform-section {
    margin-bottom: 60px;
}


.platform-card {

    position: relative;

    display: flex;
    align-items: center;
    gap: 25px;

    padding: 40px;

    border-radius: 28px;

    overflow: hidden;

    background:
        linear-gradient(
            120deg,
            rgba(30, 64, 175, 0.90),
            rgba(126, 34, 206, 0.85),
            rgba(14, 116, 144, 0.90)
        );

    box-shadow:
        0 25px 60px rgba(30, 64, 175, 0.20);
}


.platform-card::after {

    content: "";

    position: absolute;

    width: 250px;
    height: 250px;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.10);

    right: -80px;
    top: -100px;
}


.platform-icon {
    font-size: 48px;
    z-index: 2;
}


.platform-card h2 {
    margin: 0 0 8px;
    color: white;
    z-index: 2;
}


.platform-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    z-index: 2;
}


.platform-card .button {
    margin-left: auto;
    white-space: nowrap;
    z-index: 2;

    background: white;
    color: #4338ca;
}


/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 900px) {

    .hero {

        flex-direction: column;

        text-align: center;

        padding: 55px 25px;
    }


    .hero-content {
        max-width: 100%;
    }


    .hero-buttons {
        justify-content: center;
    }


    .floating-orbit {

        width: 330px;
        height: 330px;
    }


    .floating-orbit::before {

        width: 250px;
        height: 250px;

        left: 40px;
        top: 40px;
    }


    .platform-card {

        flex-direction: column;

        text-align: center;
    }


    .platform-card .button {

        margin-left: 0;
    }

}


@media (max-width: 500px) {

    .hero h1 {

        font-size: 52px;
        letter-spacing: -3px;
    }


    .floating-orbit {

        transform: scale(0.85);

        margin-top: -20px;
        margin-bottom: -20px;
    }


    .section-heading {

        align-items: flex-start;

        flex-direction: column;
    }

}

