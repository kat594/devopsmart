* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f7fa;
    color: #222;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
}

header {
    background: #111827;
    color: white;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
}

.logo {
    color: white;
    text-decoration: none;
    font-size: 24px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

main {
    min-height: 80vh;
    padding: 40px 0;
}

.hero {
    text-align: center;
    padding: 60px 20px;
}

.hero h1 {
    font-size: 48px;
}

.hero p {
    font-size: 20px;
}

.button {
    display: inline-block;
    background: #2563eb;
    color: white;
    padding: 10px 18px;
    border: none;
    border-radius: 6px;
    text-decoration: none;
    cursor: pointer;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.product-card {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.product-icon {
    font-size: 40px;
}

.product-icon.large {
    font-size: 80px;
}

.category {
    color: #2563eb;
    font-weight: bold;
}

.product-detail {
    background: white;
    padding: 40px;
    border-radius: 10px;
    display: flex;
    gap: 40px;
    align-items: center;
}

footer {
    text-align: center;
    padding: 25px;
    background: #111827;
    color: white;
}


/* ================================
   Modern DevOpsMart Homepage
   ================================ */

.hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
    padding: 70px 40px;
    margin-bottom: 70px;
    overflow: hidden;
    border-radius: 28px;
    background:
        radial-gradient(circle at 80% 20%, rgba(80, 120, 255, 0.20), transparent 30%),
        radial-gradient(circle at 20% 80%, rgba(0, 200, 180, 0.15), transparent 30%);
}

.hero-content {
    max-width: 650px;
    position: relative;
    z-index: 2;
}

.hero-badge {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 20px;
    border: 1px solid rgba(100, 120, 255, 0.35);
}

.hero h1 {
    font-size: clamp(48px, 7vw, 82px);
    line-height: 0.95;
    margin: 0 0 25px;
    letter-spacing: -4px;
}

.hero h1 span {
    display: block;
}

.hero p {
    font-size: 19px;
    line-height: 1.7;
    max-width: 600px;
    opacity: 0.8;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 30px;
    flex-wrap: wrap;
}

.secondary-button {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.floating-orbit {
    width: 400px;
    height: 400px;
    position: relative;
    flex-shrink: 0;
}

.orbit-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 42px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 0 60px rgba(80, 120, 255, 0.25);
}

.floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-radius: 16px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    animation: float 5s ease-in-out infinite;
}

.card-one {
    top: 35px;
    left: 20px;
}

.card-two {
    top: 40px;
    right: 10px;
    animation-delay: 1s;
}

.card-three {
    bottom: 45px;
    left: 30px;
    animation-delay: 2s;
}

.card-four {
    bottom: 35px;
    right: 5px;
    animation-delay: 3s;
}

@keyframes float {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-15px);
    }

}

.featured-section {
    margin-bottom: 70px;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
}

.section-label {
    font-size: 12px !important;
    font-weight: 700;
    letter-spacing: 1.5px;
    opacity: 0.55 !important;
    margin: 0 0 8px !important;
}

.section-heading h2 {
    margin: 0;
    font-size: 32px;
}

.view-all {
    text-decoration: none;
    font-weight: 600;
}

.platform-section {
    margin-bottom: 50px;
}

.platform-card {
    display: flex;
    align-items: center;
    gap: 25px;
    padding: 35px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.platform-icon {
    font-size: 45px;
}

.platform-card h2 {
    margin: 0 0 8px;
}

.platform-card p {
    margin: 0;
    opacity: 0.7;
}

.platform-card .button {
    margin-left: auto;
    white-space: nowrap;
}

@media (max-width: 900px) {

    .hero {
        flex-direction: column;
        text-align: center;
    }

    .hero-content {
        max-width: 100%;
    }

    .hero-buttons {
        justify-content: center;
    }

    .floating-orbit {
        width: 320px;
        height: 320px;
    }

    .platform-card {
        flex-direction: column;
        text-align: center;
    }

    .platform-card .button {
        margin-left: 0;
    }

}

