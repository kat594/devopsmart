{% extends "base.html" %}

{% block title %}
DevOpsMart - Products
{% endblock %}

{% block content %}

<h1>DevOps Tools</h1>

<div class="search-container">

    <form method="GET" action="/products">

        <input
            type="text"
            name="search"
            placeholder="Search DevOps tools..."
            value="{{ search }}"
        >

        <button type="submit" class="button">
            Search
        </button>

    </form>

</div>

{% if search %}
<p>
    Search results for:
    <strong>{{ search }}</strong>
</p>
{% endif %}

<div class="product-grid">

    {% for product in products %}

    <div class="product-card">

        <div class="product-icon">
            ⚙️
        </div>

        <h2>{{ product["name"] }}</h2>

        <p class="category">
            {{ product["category"] }}
        </p>

        <p>
            {{ product["description"] }}
        </p>

        <h3>
            ${{ "%.2f"|format(product["price"]) }}
        </h3>

        <a
            href="/products/{{ product['id'] }}"
            class="button"
        >
            View Details
        </a>

    </div>

    {% else %}

    <p>No DevOps tools found.</p>

    {% endfor %}

</div>

{% endblock %}
